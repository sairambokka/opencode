# ─── CTF Solver Harness ──────────────────────────────────────────────────────
# Required for the e2b tool. Get a key from https://e2b.dev/dashboard
E2B_API_KEY=

# Kali Linux template id (default works out of the box; the project's own template).
E2B_TEMPLATE_ID=md57fwzxinsmuzinmbky

# Comma-separated allowlist of targets that bypass the built-in blocklist
# (RFC1918, .gov, .mil, loopback). Supports exact hosts, *.subdomain wildcards,
# single IPs, or CIDRs.
#   CTF_ALLOWLIST=10.10.10.0/24,*.htb.lab,target.example.com
CTF_ALLOWLIST=

# Models are routed through OpenCode Zen by default. Sign in once with:
#   opencode auth login
# and pick "opencode". The default model is opencode/deepseek-v4-flash-free.
#
# If you want to route through your own provider keys instead, edit
# .opencode/opencode.jsonc and set one of these:
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
